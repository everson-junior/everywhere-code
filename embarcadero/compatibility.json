{
  "schemaVersion": 1,
  "integration": "EverywhereRAD",
  "license": "MIT",
  "status": "experimental",
  "package": "EverywhereRAD.dpk",
  "outputPattern": "build/{platform}/EverywhereRAD.bpl",
  "targets": [
    {
      "product": "RAD Studio",
      "version": "12",
      "codename": "Athens",
      "ideArchitecture": "x86",
      "platform": "Win32",
      "status": "candidate",
      "validated": false
    },
    {
      "product": "RAD Studio",
      "version": "13",
      "codename": "Florence",
      "ideArchitecture": "x86",
      "platform": "Win32",
      "status": "candidate",
      "validated": false
    },
    {
      "product": "RAD Studio",
      "version": "13",
      "codename": "Florence",
      "ideArchitecture": "x64",
      "platform": "Win64",
      "status": "candidate",
      "validated": false
    }
  ],
  "validation": {
    "licensedCompilerAvailable": false,
    "nativeBuildExecuted": false,
    "ideSmokeTestExecuted": false,
    "automaticBplRelease": false,
    "evidence": "User reported IDE build/install and initial web rendering on RAD Studio 13.2 Win32, then blank rendering after docking/moving. Current HWND/controller synchronization and bounded view-only recovery require a new native build and visual docking tests. Trial dcc rejects command-line compiling.",
    "previousIdeBuildReported": true,
    "currentUiRevisionValidated": false
  },
  "capabilities": {
    "modelessWindow": true,
    "embeddedWebView2": true,
    "docking": true,
    "editorTab": false,
    "reuseExternalService": false,
    "terminateByPort": false,
    "fmxDesignerIntegration": false
  },
  "policy": {
    "owner": "Engenharia V&D",
    "approval": "pending",
    "windowDays": 30,
    "milestones": [
      {
        "day": 0,
        "action": "Register vendor release, assign owner and open validation checklist."
      },
      {
        "day": 7,
        "action": "Triage OTA, compiler, architecture and WebView2 changes."
      },
      {
        "day": 21,
        "action": "Build with licensed compiler and run protocol plus IDE smoke tests."
      },
      {
        "day": 30,
        "action": "Publish evidence and support decision or documented blocker; never imply automatic certification."
      }
    ]
  },
  "references": [
    "https://docwiki.embarcadero.com/RADStudio/Athens/en/Main_Page",
    "https://docwiki.embarcadero.com/RADStudio/Florence/en/64-bit_IDE"
  ]
}
